<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net9.0;net8.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <!-- BenchmarkDotNet requires console executable. -->
    <OutputType>Exe</OutputType>
    <!--
      BenchmarkDotNet emits informational analyzer warnings (e.g., BDN0001, BDN0002) for
      benchmark methods returning void; these are intentional and not errors. Suppress
      only inside this project so TreatWarningsAsErrors (Directory.Build.props) does not
      reject them.
    -->
    <NoWarn>$(NoWarn);CA1822;CA1815</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.ObjectPool" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Oragon.AdaptivePool.Core\Oragon.AdaptivePool.Core.csproj" />
  </ItemGroup>
</Project>
