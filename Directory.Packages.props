<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Core library deps -->
    <!--
      Plan 01 originally pinned Logging.Abstractions and Options at 10.0.5; with CPM
      transitive pinning enabled, Microsoft.Extensions.Logging.Console 10.0.5 pulls
      Logging 10.0.6 which requires Logging.Abstractions/Options >= 10.0.6, causing
      NU1109. Aligned all M.E.* abstractions and options to 10.0.6 to satisfy CPM.
      Documented as Rule 3 deviation in SUMMARY.
    -->
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.6" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.6" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.6" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4" />
    <PackageVersion Include="MinVer" Version="6.0.0" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="8.0.0" />
    <!-- Test deps -->
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <!--
      Plan 01 originally pinned `xunit.v3.runner.visualstudio` 3.2.2; that package id
      does not exist on NuGet.org. The unified VS Test Explorer adapter for xUnit v3
      is `xunit.runner.visualstudio` (v3.x), so we pin 3.1.5 (latest stable as of
      restore time). Documented as Rule 1 deviation in SUMMARY.
    -->
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="AwesomeAssertions" Version="9.4.0" />
    <PackageVersion Include="NSubstitute" Version="5.3.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.5.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.6" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Console" Version="10.0.6" />
    <!--
      Plan 01 pinned Microsoft.Extensions.Diagnostics.Testing 10.0.5; that exact
      version is not published. The 10.x cadence for this package is 10.0.0, 10.1.0,
      10.2.0, 10.3.0, 10.4.0, 10.5.0. Pinned to 10.5.0 to match TimeProvider.Testing.
      Documented as Rule 1 deviation in SUMMARY.
    -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.5.0" />
    <!--
      Plan 03 needed `services.AddMetrics()` (registers IMeterFactory) for telemetry
      tests to attach a MetricCollector. The extension lives in Microsoft.Extensions.Diagnostics.
    -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics" Version="10.0.6" />
    <!-- CR-03 regression test only — Core does NOT reference Hosting. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.6" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <!--
      Plan 03 Task 5: Benchmark project for [LoggerMessage] allocation-free verification
      (ROADMAP success criterion 5). 0.15.4 is the most recent stable as of Plan 03 execution.
      Pinned only for the Benchmarks project; not added to CI workflow (manual-run only).
    -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.4" />
    <!-- Phase 3: RabbitMQ adapter dependency. Pin to 7.2.1 per RESEARCH.md. -->
    <PackageVersion Include="RabbitMQ.Client" Version="7.2.1" />
  </ItemGroup>
</Project>
