<?xml version="1.0" encoding="utf-8"?>
<!--
  Project-local NuGet.Config to ensure deterministic, OS-agnostic restore.
  Clears any inherited <fallbackPackageFolders> from machine-wide configs
  (e.g., Visual Studio installs that pin Windows-only paths) so the project
  builds identically on Linux, macOS, and Windows.
-->
<configuration>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
